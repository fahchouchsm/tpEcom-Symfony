<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Fahchouch Store{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #fff; }
        .product-img { height: 220px; object-fit: cover; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="{{ path('home') }}">Fahchouch Store</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="{{ path('product_list') }}">Products</a></li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('category_list') }}">Categories</a></li>
                    <li class="nav-item"><a class="nav-link" href="{{ path('cart') }}">Cart</a></li>
                    {% if app.user %}
                        <li class="nav-item"><a class="nav-link" href="{{ path('profile') }}">Bienvenue, {{ app.user.fullName }}</a></li>
                        <li class="nav-item"><a class="nav-link" href="{{ path('app_logout') }}">Logout</a></li>
                    {% else %}
                        <li class="nav-item"><a class="nav-link" href="{{ path('app_login') }}">Login</a></li>
                        <li class="nav-item"><a class="nav-link" href="{{ path('app_register') }}">Register</a></li>
                    {% endif %}
                </ul>
            </div>
        </div>
    </nav>

    <main>
        {% for message in app.flashes('success') %}
            <div class="container mt-4">
                <div class="alert alert-success">{{ message }}</div>
            </div>
        {% endfor %}

        {% block body %}{% endblock %}
    </main>

    <footer class="bg-dark text-white mt-5 py-4">
        <div class="container d-md-flex justify-content-between">
            <div>
                <h5>Fahchouch Store</h5>
                <p class="mb-0">Quality products at affordable prices</p>
            </div>
            <p class="mb-0">&copy; 2026 Fahchouch Store. All rights reserved.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
