{% extends 'base.html.twig' %}

{% block title %}Categories - Fahchouch Store{% endblock %}

{% block body %}
<div class="container my-5">
    <h1 class="mb-4">Browse Categories</h1>
    <div class="row row-cols-1 row-cols-md-3 g-4">
        {% for category in categories %}
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body text-center">
                        <span class="badge bg-primary mb-2">{{ category.products|length }} Products</span>
                        <h4 class="card-title">{{ category.name }}</h4>
                        <p class="card-text text-muted">{{ category.description }}</p>
                        <a href="{{ path('category_products', {slug: category.slug}) }}" class="btn btn-outline-primary">Browse {{ category.name }}</a>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="alert alert-info">No categories yet.</div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
