{% extends 'base.html.twig' %}

{% block title %}{{ product.name }} - Fahchouch Store{% endblock %}

{% block body %}
<div class="container my-5">
    <div class="row">
        <div class="col-md-6">
            <img src="/images/airbod.png" class="img-fluid rounded" alt="Product">
        </div>
        <div class="col-md-6">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="{{ path('product_list') }}" class="text-decoration-none">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Product Details</li>
                </ol>
            </nav>

            {% if product.category %}
                <span class="badge bg-primary mb-3">{{ product.category.name }}</span>
            {% endif %}

            <h1 class="mb-3">{{ product.name }}</h1>
            <h3 class="text-success mb-4">${{ product.price }}</h3>

            <div class="mb-4">
                <h5>Description</h5>
                <p class="text-muted">
                    {{ product.description }}
                    The foldable design makes them easy to carry, while the premium materials ensure durability
                    and long-lasting comfort.
                </p>
            </div>

            <form method="post" action="{{ path('cart_add', {id: product.id}) }}">
                <div class="mb-3">
                    <label for="quantity" class="form-label">Quantity</label>
                    <input type="number" class="form-control" id="quantity" name="quantity" value="1" min="1" max="10" style="max-width: 100px;">
                </div>
                <div class="d-grid gap-2 d-md-flex">
                    <button type="submit" class="btn btn-primary btn-lg">Add to Cart</button>
                    <a href="{{ path('product_list') }}" class="btn btn-outline-secondary btn-lg">Continue Shopping</a>
                </div>
            </form>

            <div class="mt-4 pt-4 border-top">
                <ul class="list-unstyled">
                    <li class="mb-2"><strong>SKU:</strong> WH-2024-{{ '%03d'|format(product.id) }}</li>
                    <li class="mb-2"><strong>Availability:</strong> <span class="text-success">In Stock</span></li>
                    <li class="mb-2"><strong>Category:</strong> {{ product.category ? product.category.name : 'Electronics' }}</li>
                </ul>
            </div>
        </div>
    </div>
</div>
{% endblock %}
